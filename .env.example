# Copie para .env.local (desenvolvimento) e configure as mesmas variáveis na Vercel.

# URL pública do site, sem barra no final (usada nos links dos e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Kiwify > Apps > Webhooks: o "token" do webhook (usado para verificar a assinatura)
KIWIFY_WEBHOOK_TOKEN=

# Resend (e-mails de acesso). Sem chave, os links saem só no log do servidor.
RESEND_API_KEY=
EMAIL_FROM="Revisando <acesso@seudominio.com.br>"

# Data da prova (contagem regressiva na área do aluno)
NEXT_PUBLIC_DATA_PROVA=2027-01-10T13:00:00-03:00
NEXT_PUBLIC_SUPORTE_EMAIL=

# WhatsApp de atendimento (só números, com 55 + DDD). A isca leva o lead para este número
# e o painel usa para as conversas de venda.
WHATSAPP_NUMERO_ATENDIMENTO=
# Opcional: envio automático do PDF pela API oficial do WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_ISCA=revisao_3_dias

# Lembretes diários: segredo que o agendador do Supabase envia (ver supabase/agendar-lembretes.sql)
CRON_SECRET=
# Modelo aprovado na Meta para o lembrete diário pelo WhatsApp (4 variáveis no corpo)
WHATSAPP_TEMPLATE_LEMBRETE=lembrete_estudo
